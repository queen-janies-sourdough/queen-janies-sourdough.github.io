---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Queen Janie's Sourdough | Artisan Sourdough in McAllen, TX",
  description = "Small-batch, handcrafted artisan sourdough breads and hands-on sourdough classes from Queen Janie's Sourdough in McAllen, TX. Real ingredients, homemade with love.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="180x180" href="/assets/img/favicon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Caveat:wght@500;600;700&family=Playfair+Display:wght@500;600;700&family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/assets/css/styles.css" />
  </head>
  <body>
    <slot />
    <script src="/assets/js/main.js" is:inline></script>
  </body>
</html>
